# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# --- Customization ---
alias open='xdg-open'
echo -en "\033]0;javi@Arthur\a"
bind 'set show-all-if-ambiguous on'
_update_prompt() {
  local error=${GLOBAL_EXIT_CODE:-$?}
  local c
  local g
  
  if [ $error -eq 0 ]; then
    c="✔️ " 
  else
    c="❌"
  fi

  # We use \[ and \] to tell Bash which characters don't take up physical space
  if [ -d ".git" ] || git rev-parse --git-dir > /dev/null 2>&1; then
    local branch=$(git branch --show-current)
    # Correctly escaping the green color and the cyan reset for the branch
    g="(\[\e[0;32m\]${branch}\[\e[1;36m\])"
  else
    g=""
  fi

  PS1="\[\e[1;36m\]\w${g}[${c}] \[\e[0m\]"
}
PROMPT_COMMAND=_update_prompt


# [2026-01-13] yups_fixes.bash - Correcciones para hooks y bindings de YUPS

# --- YUPS_HOOK_START ---
command_not_found_handle() {
    # Usamos "$@" directamente, es más seguro
    if "/usr/local/bin/yups" --command-not-found "$@"; then
        value=127   #$?
    else
        value=127
    fi
    echo "DEBUG: Full Line was: '$LAST_FULL_COMMAND'"
    echo "DEBUG: Trap: '$YUPS_LAST_CMD'"
    GLOBAL_EXIT_CODE=127
    return $value
}
export -f command_not_found_handle

_capture_exit_code() {
    export GLOBAL_EXIT_CODE=$?
}

_yups_ce_handle() {
    local exit_code=${GLOBAL_EXIT_CODE:-0}
    ARG_CMD=$1
    # Evitamos bucles infinitos o ruido innecesario
    if [[ $exit_code -eq 0 ]] || [[ $exit_code -eq 127 ]] || [[ $exit_code -eq 130 ]]; then
        return
    fi
    # Nota: Aquí LAST_FULL_COMMAND ya estará disponible gracias al fix del bind
    "/usr/local/bin/yups" --command-error "$exit_code" "$YUPS_LAST_CMD"
    
    # Debug visual (puedes quitarlo luego)
    echo "DEBUG: Full Line was: '$LAST_FULL_COMMAND'"
}
export -f _yups_ce_handle

if [[ -z "$PROMPT_COMMAND" ]]; then
    export PROMPT_COMMAND="_capture_exit_code;_yups_ce_handle"
elif ! [[ "$PROMPT_COMMAND" == *"_yups_ce_handle"* ]]; then
    export PROMPT_COMMAND="_capture_exit_code;_yups_ce_handle;${PROMPT_COMMAND}"
fi

_yups_save_last_cmd() {
    if [[ "$BASH_COMMAND" != "_capture_exit_code" ]] && \
        [[ "$BASH_COMMAND" != "_yups_ce_handle" ]]&& \
	[[ "$BASH_COMMAND" != "update_prompt" ]]; then
        export YUPS_LAST_CMD="$BASH_COMMAND"
    fi
}
trap '_yups_save_last_cmd' DEBUG
# --- YUPS_HOOK_END ---

explain_current_line() {
    local tokens=($READLINE_LINE) 
    local wrappers=("sudo" "su" "runuser" "chroot" "doas" "time" "watch" "timeout" "stdbuf" "nohup" "xargs" "exec" "env" "strace" "nice" "runcon" "setpriv" "bash" "sh")

    for token in "${tokens[@]}"; do
        if [[ "$token" == *"="* ]]; then continue; fi

        local is_wrapper=false
        for w in "${wrappers[@]}"; do
            [[ "$token" == "$w" ]] && is_wrapper=true && break
        done
        
        if [[ "$is_wrapper" == false ]]; then
            # --- VISUAL SETUP ---
            printf "${PS1@P}$READLINE_LINE\n"
            
            if [[ ${#token} -ge 2 ]]; then
		if man -w "$token" >/dev/null 2>&1; then
		    local token_c=$token
		else
                    local token_c=$(compgen -c | grep "^$token" | head -n 1)
                fi

                if [ -n "$token_c" ]; then
                    echo "Found: $token_c"
                    type "$token_c" 2>/dev/null | head -n 1
                    whatis "$token_c" 2>/dev/null

                    # --- FLAGS ANALYSIS ---
                    local man_content
                    if man -w "$token_c" >/dev/null 2>&1; then
                        man_content=$(man -P cat "$token_c" 2>/dev/null | col -b)
                    else
                        echo "No manual entry for $token_c"
                        READLINE_LINE="$READLINE_LINE" 
                        return
                    fi

                    _search_flag_in_man() {
                        local f="$1"
                        local escaped_arg=$(printf '%s\n' "$f" | sed 's/[.[\*^$]/\\&/g')
                        
                        local help_text=$(echo "$man_content" | sed -n "/^\s\+${escaped_arg}\( \|,\|$\)/,/^\s*$/p")
                        
                        if [[ -n "$help_text" ]]; then
                            echo -e "\033[1;33m$f\033[0m found:"
                            echo "$help_text" | sed 's/^/  /'
                        else
                            echo -e "\033[1;31m$f\033[0m: No description found."
                        fi
                    }

                    for arg in "${tokens[@]}"; do
                        # CASE 1: Long Option (--flag)
                        if [[ "$arg" == --* ]]; then
                            _search_flag_in_man "$arg"
                        
                        # CASE 2: Short Option Cluster (-xyz)
                        elif [[ "$arg" == -* ]]; then
                            local chars="${arg:1}"
                            
                            for (( i=0; i<${#chars}; i++ )); do
                                local char="${chars:$i:1}"
                                _search_flag_in_man "-$char"
                            done
                        fi
                    done
                else
                    echo "No commands found similar to '$token'"
                fi
            fi
            
            READLINE_LINE="$READLINE_LINE" 
            return
        fi
    done
}
bind -x '"\C-@": explain_current_line'

# --- FIX 2: Capturar Enter correctamente ---

# Función que guarda la variable
_save_full_command_line() {
    export LAST_FULL_COMMAND="$READLINE_LINE"
}

# PASO 1: Asignamos la función a una secuencia "secreta" (Ctrl+X Ctrl+L)
bind -x '"\C-x\C-l": _save_full_command_line'

# PASO 2: Creamos una MACRO para Ctrl+M (Enter)
# La secuencia hace:
# \C-x\C-l  -> Ejecuta nuestra función oculta
# \C-j      -> Ejecuta 'accept-line' (equivalente a dar enter)
bind '"\C-m": "\C-x\C-l\C-j"'
